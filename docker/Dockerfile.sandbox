# syntax=docker/dockerfile:1

FROM python:3.11-slim-bookworm AS base

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN python -m pip install --no-cache-dir "uv==0.9.21"

FROM base AS dependencies

WORKDIR /opt/mycode-source
COPY --from=mycode README.md pyproject.toml uv.lock ./
RUN UV_PROJECT_ENVIRONMENT=/opt/mycode-venv \
    uv sync --locked --no-dev --no-install-project

FROM dependencies AS sandbox-tools

RUN apt-get -o Acquire::Retries=3 update \
    && apt-get -o Acquire::Retries=3 install -y --no-install-recommends \
        ca-certificates curl findutils git grep unzip wget zip \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 --shell /bin/bash mycode

FROM sandbox-tools AS application

COPY --from=mycode mycode /opt/mycode-source/mycode
RUN UV_PROJECT_ENVIRONMENT=/opt/mycode-venv \
    uv sync --locked --no-dev --inexact \
    && ln -s /opt/mycode-venv/bin/mycode /usr/local/bin/mycode \
    && mkdir -p /workspace /home/mycode/.mycode \
    && chown -R mycode:mycode /workspace /home/mycode

USER mycode
WORKDIR /workspace
CMD ["mycode", "agent", "--continue"]
