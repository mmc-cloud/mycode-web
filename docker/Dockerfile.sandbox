# syntax=docker/dockerfile:1

FROM python:3.11-slim-bookworm AS base

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN python -m pip install --no-cache-dir "uv==0.9.21"

FROM base AS dependencies

WORKDIR /opt/mycode-source
COPY --from=mycode README.md pyproject.toml uv.lock ./
RUN UV_PROJECT_ENVIRONMENT=/opt/mycode-venv \
    uv sync --locked --no-dev --no-install-project

FROM dependencies AS sandbox-tools

RUN apt-get -o Acquire::Retries=3 update \
    && apt-get -o Acquire::Retries=3 install -y --no-install-recommends \
        ca-certificates curl findutils git grep unzip wget zip \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 workspace \
    && useradd --create-home --uid 10001 --gid workspace \
        --home-dir /home/mycode --shell /bin/bash mycode-agent \
    && useradd --create-home --uid 10002 --gid workspace \
        --home-dir /home/workspace-user --shell /bin/bash workspace-user

FROM sandbox-tools AS application

COPY --from=mycode mycode /opt/mycode-source/mycode
COPY docker/entrypoint-sandbox.sh /usr/local/bin/sandbox-entrypoint
RUN UV_PROJECT_ENVIRONMENT=/opt/mycode-venv \
    uv sync --locked --no-dev --inexact \
    && ln -s /opt/mycode-venv/bin/mycode /usr/local/bin/mycode \
    && mkdir -p /workspace /home/mycode/.mycode \
    && chmod 0755 /usr/local/bin/sandbox-entrypoint \
    && chown -R mycode-agent:workspace /workspace /home/mycode \
        /opt/mycode-venv \
    && chown -R workspace-user:workspace /home/workspace-user \
    && chmod 2775 /workspace \
    && chmod 0700 /home/mycode /home/workspace-user /opt/mycode-venv

USER mycode-agent
WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/sandbox-entrypoint"]
CMD ["mycode", "agent", "--continue"]
