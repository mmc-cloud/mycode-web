# FastAPI host configuration. Reference for new installs only; never overwrite an existing production .env.
MYCODE_SERVER_DATA_DIR=./data
MYCODE_SANDBOX_IMAGE=mycode-sandbox:dev
MYCODE_RELAY_BASE_URL_FOR_SANDBOX=http://host.docker.internal:8000/web/api/relay/v1
# Keep false for local HTTP; set true behind the production HTTPS endpoint.
MYCODE_COOKIE_SECURE=false

# Sandbox pool, queue, Docker resource limits, and lifecycle defaults.
SANDBOX_MAX_ACTIVE=2
SANDBOX_QUEUE_MAX=20
SANDBOX_MAX_ACTIVE_PER_USER=5
SANDBOX_MEMORY_LIMIT=640m
SANDBOX_MEMORY_SWAP_LIMIT=1g
SANDBOX_CPUS=1.0
SANDBOX_PIDS_LIMIT=256
SANDBOX_IDLE_TTL_SECONDS=7200
RUNTIME_SWEEP_INTERVAL_SECONDS=60
SESSION_RETENTION_SECONDS=1209600
SESSION_CLEANUP_INTERVAL_SECONDS=3600

# Real provider credentials stay on the FastAPI host and are never passed to Docker.
MYCODE_PROVIDER_API_KEY=replace-me
MYCODE_PROVIDER_BASE_URL=https://api.openai.com/v1
MYCODE_MODEL=gpt-5.4

# Optional MyCode model/runtime values are passed through as strings only when set.
# MYCODE_COMPACT_MODEL=gpt-5.4
# MYCODE_SUBAGENT_MODEL=gpt-5.4
# LLM_CONTEXT_WINDOW_TOKENS=128000
# LLM_RESERVED_OUTPUT_TOKENS=8192
# LLM_CONTEXT_SAFETY_MARGIN_TOKENS=4096
# LLM_MEMORY_CONTEXT_TOKENS=2048
# LLM_STREAM_INCLUDE_USAGE=true
# LLM_THINKING_ENABLED=true
# LLM_REASONING_EFFORT=high
# LLM_MAX_OUTPUT_TOKENS=8192
